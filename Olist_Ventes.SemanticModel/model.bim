            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "084e53cd-a5e0-4e3d-abca-828c155b654a",
        "measures": [
          {
            "name": "Chiffre d'affaires",
            "expression": "SUM(Fait_Ventes[price])",
            "formatString": "\"R$\" #,0",
            "lineageTag": "ab192cba-34fa-4616-aaf4-0dfd580a877f"
          },
          {
            "name": "Commandes",
            "expression": "DISTINCTCOUNT(Fait_Ventes[order_id])",
            "formatString": "#,0",
            "lineageTag": "3fe6ab6b-f5fc-42e6-a513-764411d0a97a"
          },
          {
            "name": "Panier moyen",
            "expression": "DIVIDE([Chiffre d'affaires], [Commandes])",
            "formatString": "\"R$\" #,0.00",
            "lineageTag": "6e1a29d5-13a5-441d-ab4f-beeb660d355a"
          },
          {
            "name": "Clients uniques",
            "expression": "DISTINCTCOUNT(Fait_Ventes[customer_unique_id])",
            "formatString": "#,0",
            "lineageTag": "b81ebb4a-72e8-4a06-8584-4c1fce371955"
          },
          {
            "name": "CA mensuel",
            "expression": "CALCULATE([Chiffre d'affaires], KEEPFILTERS(Dim_Date[annee] >= 2017))",
            "formatString": "\"R$\" #,0",
            "lineageTag": "b18226f3-800d-4ea0-9ad0-8d58fbd8220b"
          },
          {
            "name": "Part du CA",
            "expression": "DIVIDE([Chiffre d'affaires], CALCULATE([Chiffre d'affaires], ALLSELECTED()))",
            "formatString": "0.0%",
            "lineageTag": "f4107179-ec70-40d6-8be6-090c7e865463"
          },
          {
            "name": "CA Top 10 catégories",
            "expression": [
              "VAR Rang =",
              "    RANKX(ALLSELECTED(Dim_Produit[categorie_fr]), [Chiffre d'affaires], , DESC, Skip)",
              "RETURN",
              "    IF(NOT ISBLANK([Chiffre d'affaires]) && Rang <= 10, [Chiffre d'affaires])"
            ],
            "formatString": "\"R$\" #,0",
            "lineageTag": "a6704a20-7b0b-4c25-8365-d0073cea350e"
          },
          {
            "name": "CA Top 10 produits",
            "expression": [
              "VAR Rang =",
              "    RANKX(ALLSELECTED(Dim_Produit[produit_libelle]), [Chiffre d'affaires], , DESC, Skip)",
              "RETURN",
              "    IF(NOT ISBLANK([Chiffre d'affaires]) && Rang <= 10, [Chiffre d'affaires])"
            ],
            "formatString": "\"R$\" #,0",
            "lineageTag": "031fd5f5-e097-4587-9ab6-3a82ebcba5ea"
          },
          {
            "name": "CA Top 10 villes",
            "expression": [
              "VAR Rang =",
              "    RANKX(ALLSELECTED(Dim_Client[ville_etat]), [Chiffre d'affaires], , DESC, Skip)",
              "RETURN",
              "    IF(NOT ISBLANK([Chiffre d'affaires]) && Rang <= 10, [Chiffre d'affaires])"
            ],
            "formatString": "\"R$\" #,0",
            "lineageTag": "fa5ae71b-c62f-4162-bce0-31afd69c3dc3"
          },
          {
            "name": "CA Top 10 États",
            "expression": [
              "VAR Rang =",
              "    RANKX(ALLSELECTED(Dim_Client[etat_libelle]), [Chiffre d'affaires], , DESC, Skip)",
              "RETURN",
              "    IF(NOT ISBLANK([Chiffre d'affaires]) && Rang <= 10, [Chiffre d'affaires])"
            ],
            "formatString": "\"R$\" #,0",
            "lineageTag": "b78dff48-73d4-42bb-8f5d-22fedb85871d"
          }
        ],
        "partitions": [
          {
            "name": "Fait_Ventes",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DossierDonnees & \"Fait_Ventes.csv\"), [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Entetes, {{\"order_id\", type text}, {\"order_item_id\", Int64.Type}, {\"customer_id\", type text}, {\"customer_unique_id\", type text}, {\"product_id\", type text}, {\"date_achat\", type date}, {\"price\", Currency.Type}, {\"freight_value\", Currency.Type}}, \"en-US\")",
                "in",
                "    Types"
              ],
              "type": "m"
            }
          }
